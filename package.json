{
  "name": "invmage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A clean Material 3 inventory management app",
  "scripts": {
    "dev": "concurrently -k -n \"api,app\" -c \"cyan,magenta\" \"node server/index.js\" \"vite\"",
    "dev:frontend": "vite",
    "server": "node server/index.js",
    "db:init": "node server/init-db.js",
    "build": "vite build",
    "preview": "vite preview",
    "test:flow": "node scripts/test-flow.mjs",
    "test:postgres": "node scripts/test-groups-and-postgres.mjs",
    "test:capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.113",
    "@ai-sdk/openai": "^4.0.110",
    "@ai-sdk/react": "^4.0.168",
    "@fontsource-variable/roboto": "^5.3.0",
    "@material-symbols/svg-400": "^0.48.3",
    "ai": "^7.0.164",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.6"
  }
