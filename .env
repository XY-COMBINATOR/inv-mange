# Server Port
PORT=3001

# PostgreSQL Connection URL
# Set this to your PostgreSQL instance (e.g. local install or Docker container)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/invmage

# Individual PostgreSQL parameters (optional fallback)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgrespassword
PGDATABASE=invmage

